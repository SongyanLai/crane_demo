-- Example 4b: a design that follows the suggested wording (Table 12 in the report).
-- Same closed loop as Example 2 (hook zones, permanent fault of the primary limit), plus an emergency stop.
-- One step = one PLC scan. Illustrative logic written by us, NOT company code.
MODULE main
VAR
  joy_up         : boolean;  -- master controller deflected: hoist up
  joy_down       : boolean;  -- master controller deflected: lower
  estop          : boolean;  -- NEW: emergency stop pressed
  backup_reset   : boolean;  -- special reset of the backup limiter (not at the operator station)
  primary_failed : boolean;  -- single fault: primary upper limit switch stuck, never signals
  zone : 0..3;               -- 0 working range, 1 primary limit zone, 2 backup limit zone, 3 TWO-BLOCK
  backup_latched : boolean;  -- remembers a backup trip until the special reset
ASSIGN
  init(zone) := 0;
  next(zone) := case
      up_cmd   & zone < 3 : zone + 1;
      down_cmd & zone > 0 : zone - 1;
      TRUE                : zone;
    esac;
  next(primary_failed) := primary_failed;
  init(backup_latched) := FALSE;
  next(backup_latched) := case
      next(backup_limit) & !backup_limit : TRUE;   -- trip (rising edge) sets the latch
      next(backup_reset)                 : FALSE;  -- only the special reset clears it
      TRUE                               : backup_latched;
    esac;
DEFINE
  upper_limit  := zone >= 1 & !primary_failed;
  backup_limit := zone >= 2;
  -- hoist logic following the suggested wording: E-stop first, then lock-out, limits, conflicting commands
  up_cmd   := joy_up & !joy_down & !upper_limit & !backup_limit & !backup_latched & !estop;
  down_cmd := joy_down & !joy_up & !backup_latched & !estop;

-- Rules of Example 2
LTLSPEC NAME P1_no_two_block := G (zone < 3)
LTLSPEC NAME P2_no_hoisting_at_limits := G ((upper_limit | backup_limit) -> !up_cmd)
LTLSPEC NAME P3_backup_lockout := G ( (!backup_reset S (backup_limit & !(Y backup_limit))) -> (!up_cmd & !down_cmd) )
-- Suggested #1: the emergency stop inhibits all motion
LTLSPEC NAME E1_estop := G (estop -> (!up_cmd & !down_cmd))
-- Suggested #16: simultaneous up and down create no motion
LTLSPEC NAME C16_conflicting_cmds := G ((joy_up & joy_down) -> (!up_cmd & !down_cmd))
-- Suggested #4: at the primary upper limit, lowering stays possible unless E-stop, Hoist Up, or backup lock-out
LTLSPEC NAME L4_lowering_possible := G ( (upper_limit & joy_down & !joy_up & !estop & !(!backup_reset S (backup_limit & !(Y backup_limit)))) -> down_cmd )
-- Sanity (non-vacuity): hoisting and lowering always remain reachable
SPEC NAME S1_hoisting_still_possible := AG EF up_cmd
SPEC NAME S2_lowering_still_possible := AG EF down_cmd
