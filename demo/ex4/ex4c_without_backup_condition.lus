-- Example 4c: like 4a, but the suggested #4 WITHOUT its third condition (backup limit tripped and not reset).
-- Inputs (operator and sensors): estop, upper_limit, backup_limit, backup_reset, joy_up, joy_down
-- Outputs (hoist control logic): up_cmd, down_cmd        One step = one PLC scan.
node imported Hoist(estop, upper_limit, backup_limit, backup_reset, joy_up, joy_down : bool)
returns (up_cmd, down_cmd : bool);
(*@contract
  -- Helper: the backup limit trips (switches on) in this step.
  var trip : bool = backup_limit and not (false -> pre backup_limit);
  -- Helper: the backup limit has tripped and there has been no special reset since then.
  var locked : bool = trip or (false -> (pre locked and not backup_reset));
  -- #1 (suggested): the emergency stop inhibits all motion and has priority over all other functions.
  guarantee "S01_estop" estop => (not up_cmd and not down_cmd);
  -- #3, #5, #27: no hoisting up while either upper limit is active.
  guarantee "S03_no_hoisting_at_limits" (upper_limit or backup_limit) => not up_cmd;
  -- #4 (suggested): at the primary upper limit, lowering remains possible without a reset,
  --     unless the emergency stop is active, Hoist Up is commanded at the same time,
  --     or the backup limit has tripped and has not been reset.
  guarantee "S04_lowering_possible" (upper_limit and joy_down and not joy_up and not estop) => down_cmd;
  -- #16 (suggested): simultaneous Hoist Up and Hoist Down from the master controller create no motion.
  guarantee "S16_conflicting_cmds" (joy_up and joy_down) => (not up_cmd and not down_cmd);
  -- New rule (EN 12077-2:2024, 4.6.1.4): after a backup trip, no motion in either direction until the reset.
  guarantee "N1_backup_lockout" locked => (not up_cmd and not down_cmd);
*)
